description="X keyboard configuration database"
url="https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Greg,Tnut"

_name=xkeyboard-config
name=xorg-xkeyboard-config

makedepends=(git intltool xorgproto xorg-libx11 perl-xml-parser)

_name=xkeyboard-config-xkeyboard-config
name=xorg-xkeyboard-config
version=2.49

alias=(xkeyboard-config)

source=(https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config/-/archive/xkeyboard-config-2.49/xkeyboard-config-xkeyboard-config-2.49.tar.gz)

PKGMK_MESON_OPTIONS="-Dcompat-rules=true -Dxorg-rules-symlinks=true"

prepare() {
  mv ${_name}-$version $name-$version
}
build=meson

package() {
  ln -s us $PKG/usr/share/xkeyboard-config-2/symbols/uk
}

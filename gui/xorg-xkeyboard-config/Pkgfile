description="X keyboard configuration database"
url="https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Greg,Spiky"

_name=xkeyboard-config
name=xorg-xkeyboard-config

makedepends=(intltool xorgproto xorg-libx11 perl-xml-parser)

_name=xkeyboard-config
name=xorg-xkeyboard-config
version=2.48
release=2

alias=(xkeyboard-config)

source=(https://xorg.freedesktop.org/archive/individual/data/${_name}/${_name}-$version.tar.xz)

PKGMK_MESON_OPTIONS="-Dcompat-rules=true -Dxorg-rules-symlinks=true"

prepare() {
  mv ${_name}-$version $name-$version
}
build=meson

package() {
  ln -s us $PKG/usr/share/xkeyboard-config-2/symbols/uk
}
